{
  "manifest": 2,
  "id": "publicbank",
  "name": "Public Bank",
  "version": "0.1.0",
  "description": "Your residency's budget, decided by its members: propose, offer, split 100 points, approve the plan. Your agent can draft on your behalf; you approve every step.",
  "homepage": "https://github.com/The-Cybernetic-Society/public-bank",
  "owner": {
    "org": "The-Cybernetic-Society"
  },
  "credit": {
    "role": "product",
    "name": "The Cybernetic Society"
  },
  "visibility": "sandbox",
  "permissions": [
    {
      "kind": "read",
      "label": "See your node's round",
      "description": "Read the current round of a node you belong to: the proposal list, the plans, your own receipt, and whether your ballot and approval are in."
    },
    {
      "kind": "action",
      "label": "Propose, offer, vote and approve for you",
      "description": "Submit a proposal, record an offer, submit your 100-point ballot, or approve the plan, only when you confirm. Nothing is read from your agent or your context."
    }
  ],
  "service": {
    "kind": "mcp",
    "baseUrl": "https://PUBLIC_URL_AFTER_DEPLOY/mcp",
    "auth": {
      "mode": "app-token",
      "secretRef": "PUBLICBANK_APP_TOKEN"
    }
  },
  "operations": [
    {
      "name": "publicbank.status",
      "class": "read",
      "target": {
        "tool": "publicbank_status"
      },
      "maxRequestBytes": 4096,
      "maxResponseBytes": 65536,
      "timeoutMs": 10000,
      "framing": "data"
    },
    {
      "name": "publicbank.propose",
      "class": "write",
      "target": {
        "tool": "publicbank_propose"
      },
      "maxRequestBytes": 8192,
      "maxResponseBytes": 4096,
      "timeoutMs": 10000,
      "framing": "data"
    },
    {
      "name": "publicbank.lead",
      "class": "write",
      "target": {
        "tool": "publicbank_lead"
      },
      "maxRequestBytes": 2048,
      "maxResponseBytes": 4096,
      "timeoutMs": 10000,
      "framing": "data"
    },
    {
      "name": "publicbank.offer",
      "class": "write",
      "target": {
        "tool": "publicbank_offer"
      },
      "maxRequestBytes": 4096,
      "maxResponseBytes": 4096,
      "timeoutMs": 10000,
      "framing": "data"
    },
    {
      "name": "publicbank.ballot",
      "class": "write",
      "target": {
        "tool": "publicbank_ballot"
      },
      "maxRequestBytes": 8192,
      "maxResponseBytes": 4096,
      "timeoutMs": 10000,
      "framing": "data"
    },
    {
      "name": "publicbank.approve",
      "class": "write",
      "target": {
        "tool": "publicbank_approve"
      },
      "maxRequestBytes": 2048,
      "maxResponseBytes": 4096,
      "timeoutMs": 10000,
      "framing": "data"
    }
  ],
  "data": {
    "context": {
      "maxEntries": 2,
      "ceiling": "village"
    }
  },
  "skills": [
    {
      "name": "publicbank",
      "version": "0.1.0",
      "sha256": "387b68246435d4628e2d13bacffa95608e04f3b3ecde1c50c9dff01ca6ab7411",
      "path": "skills/publicbank/SKILL.md"
    }
  ]
}
