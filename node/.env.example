# --- required ---
PB_SECRET=change-me-long-random            # signs the web session cookie (openssl rand -hex 32)
PB_BASE_URL=https://bank.cyberneticsutra.com   # public URL; goes into join links, posters, bot messages, webhook
DATABASE_URL=                              # Railway Postgres sets this; unset = local SQLite at PB_DB
PB_DB=./publicbank.sqlite                  # local dev / tests only

# --- Telegram (bot from @BotFather) ---
TELEGRAM_BOT_TOKEN=
PB_BOT_USERNAME=PublicBankBot              # without @
PB_BOT_POLLING=                            # set to 1 for local dev without a public URL

# --- Edge City third-party auth (from EdgeOS admin); sign-in is hidden until set ---
EDGEOS_API_BASE=https://api.edgeos.world
EDGEOS_APP_KEY=
EDGEOS_POPUP_ID=

# --- Agent Village mini-app: shared secret the dispatcher sends as Authorization: Bearer ---
PB_APP_TOKEN=

# --- WhatsApp (Meta Cloud API); the webhook is /wa. Unset PB_WA_TOKEN and the adapter sends nothing ---
PB_WA_TOKEN=                               # Cloud API access token
PB_WA_PHONE_ID=                            # the phone number id the API sends from
PB_WA_NUMBER=                              # that number as digits (country code first), for wa.me join links
PB_WA_VERIFY_TOKEN=                        # any string; paste the same into the webhook subscription
PB_WA_APP_SECRET=                          # the Meta app secret; every webhook body is checked against it
PB_WA_POOL=                                # node id a business joins under when it sends JOIN with no code
PB_WA_TEMPLATE=                            # approved template with one {{1}} body parameter, for messages outside the 24h window
PB_WA_OTP_TEMPLATE=                        # approved AUTHENTICATION template (copy-code button) for the sign-in codes cyberneticsociety.com/app asks for
PB_APP_ORIGINS=                            # origins that may call /auth/wa/* and /me/* from a browser; default: cyberneticsociety.com, www, localhost:8031

# --- the twin (needs → draft proposals). Plain word grouping by default; with a key, the model groups and prices ---
ANTHROPIC_API_KEY=
PB_TWIN_IDEAL_RUPEES=10000                 # plain path: ideal per business in a group
