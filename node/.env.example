# --- required ---
PB_SECRET=change-me-long-random            # signs the web session cookie
PB_BASE_URL=https://bank.example.org       # public URL; goes into join links, posters and bot messages
PB_DB=/data/publicbank.sqlite              # SQLite file (mount a volume)

# --- Telegram (bot from @BotFather) ---
TELEGRAM_BOT_TOKEN=
PB_BOT_USERNAME=PublicBankBot              # without @

# --- Edge City third-party auth (from Timour / EdgeOS admin); sign-in is hidden until set ---
EDGEOS_API_BASE=https://api.edgeos.world
EDGEOS_APP_KEY=
EDGEOS_POPUP_ID=

# --- Agent Village mini-app (shared secret the dispatcher sends as Authorization: Bearer) ---
PB_APP_TOKEN=
