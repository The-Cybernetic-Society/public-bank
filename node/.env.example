# --- required ---
PB_SECRET=change-me-long-random            # signs the web session cookie (openssl rand -hex 32)
PB_BASE_URL=https://bank.cyberneticsutra.com   # public URL; goes into join links, posters, bot messages, webhook
DATABASE_URL=                              # Railway Postgres sets this; unset = local SQLite at PB_DB
PB_DB=./publicbank.sqlite                  # local dev / tests only

# --- Telegram (bot from @BotFather) ---
TELEGRAM_BOT_TOKEN=
PB_BOT_USERNAME=PublicBankBot              # without @
PB_BOT_POLLING=                            # set to 1 for local dev without a public URL

# --- Edge City third-party auth (from EdgeOS admin); sign-in is hidden until set ---
EDGEOS_API_BASE=https://api.edgeos.world
EDGEOS_APP_KEY=
EDGEOS_POPUP_ID=

# --- Agent Village mini-app: shared secret the dispatcher sends as Authorization: Bearer ---
PB_APP_TOKEN=
